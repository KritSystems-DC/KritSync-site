// Krit-Faslo commented configuration.
//
// The runtime file is config.json. Keep config.json as strict JSON.
{
  // Enables or disables all plugin behavior.
  "Enabled": true,

  // License token issued for this server.
  "LicenseKey": "",

  // Fallback harvest multiplier used when GameUserSettings.ini is not read.
  "HarvestMultiplier": 10.0,

  // When true, reads HarvestAmountMultiplier from GameUserSettings.ini.
  "ReadHarvestAmountMultiplierFromIni": true,

  // Optional full path to GameUserSettings.ini. Leave empty for the default server path lookup.
  "GameUserSettingsPath": "",

  // Official baseline flint amount used when deciding whether a stack should be adjusted.
  "BaselineOfficialFlint": 80,

  // Minimum target flint amount selected by the scaler.
  "TargetFlintMin": 350,

  // Maximum target flint amount selected by the scaler.
  "TargetFlintMax": 550,

  // Minimum incoming flint amount that can trigger scaling.
  "MinTriggerAmount": 1,

  // Maximum incoming flint amount that can trigger scaling.
  "MaxTriggerAmount": 120,

  // Percentage tolerance around the selected target amount.
  "VariancePercent": 10,

  // Sends a HUD message when extra flint is added.
  "ShowHudNotificationForExtraFlint": false,

  // Writes additional diagnostics to FasolaFlintScaler.debug.log.
  "DebugLogging": false,

  // Character blueprint classes treated as Fasola targets.
  "FasolaClasses": [
    "Fasola_Character_BP_C",
    "Fasola_Character_BP_Aberrant_C"
  ],

  // Flint resource blueprint class.
  "FlintClass": "PrimalItemResource_Flint_C"
}
