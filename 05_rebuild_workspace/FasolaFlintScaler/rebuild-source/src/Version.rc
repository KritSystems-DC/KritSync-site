#include <windows.h>
#include "FasolaFlintScaler/Version.h"

1 VERSIONINFO
FILEVERSION FASOLA_VERSION_MAJOR,FASOLA_VERSION_MINOR,FASOLA_VERSION_PATCH,0
PRODUCTVERSION FASOLA_VERSION_MAJOR,FASOLA_VERSION_MINOR,FASOLA_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Krit-Faslo"
            VALUE "FileDescription", "Krit-Faslo ASA plugin"
            VALUE "FileVersion", FASOLA_VERSION_STRING
            VALUE "InternalName", FASOLA_INTERNAL_NAME
            VALUE "OriginalFilename", "Krit-Faslo.dll"
            VALUE "ProductName", FASOLA_PRODUCT_NAME
            VALUE "ProductVersion", FASOLA_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
